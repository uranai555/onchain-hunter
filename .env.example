# API Keys
# Dune Analytics
DUNE_API_KEY=

# Flipside Crypto
FLIPSIDE_API_KEY=

# Hyperliquid
# No API key needed for public info endpoint
# ウォレットごとのAPI呼び出し間隔（秒）。短くすると高速だが 429 リスク増（デフォルト 3.5）
HL_RATE_LIMIT_DELAY=3.5
# API 呼び出し失敗時の最大リトライ回数（回）（デフォルト 3）
HL_MAX_RETRIES=3

# DefiLlama
# No API key needed for free tier

# Nansen (optional)
